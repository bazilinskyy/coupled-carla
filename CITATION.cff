    given-names: Pavlo
    affiliation: Eindhoven University of Technology
repository-code: "https://github.com/bazilinskyy/coupled-carla"
license: MIT
keywords:
  - driving simulator
  - human factors
  - CARLA
  - SUMO
  - OpenStreetMap
  - digital twin
  - external human-machine interface
