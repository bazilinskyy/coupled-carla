+namespace
+{
+  /// A level's OpenDrive folder can hold more .xodr files than the level's own (a backup copy kept beside it, a
+  /// variant): <MapName>.xodr goes first, whatever order the file system lists them in.
+  void PutOwnXODRFirst(TArray<FString> &Files, const FString &MapName)
+  {
+    const FString Own = MapName + TEXT(".xodr");
+    Files.StableSort([&Own](const FString &A, const FString &B)
+    {
+      return FPaths::GetCleanFilename(A).Equals(Own, ESearchCase::IgnoreCase) &&
+             !FPaths::GetCleanFilename(B).Equals(Own, ESearchCase::IgnoreCase);
+    });
+  }
+} // namespace
