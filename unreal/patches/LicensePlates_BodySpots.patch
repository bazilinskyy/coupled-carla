+  /// BodySpots of a body mesh, worked out once per mesh asset.
+  TArray<FPlateSpot> BodySpotsOf(USkeletalMeshComponent *Body)
+  {
+    static TMap<TWeakObjectPtr<USkeletalMesh>, TArray<FPlateSpot>> Cache;
+    USkeletalMesh *Asset = Body != nullptr ? Body->GetSkeletalMeshAsset() : nullptr;
+    if (Asset == nullptr)
+    {
+      return {};
+    }
+    if (const TArray<FPlateSpot> *Found = Cache.Find(Asset))
+    {
+      return *Found;
+    }
+    TArray<FVector> Corners;
+    PlateTriangles(Body, -1, Corners);
+    return Cache.Add(Asset, BodySpots(Corners));
+  }
