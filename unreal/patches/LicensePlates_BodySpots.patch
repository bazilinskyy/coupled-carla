+  /// Usual heights of a plate's centre above the ground (cm): the rear plate on the bumper or the tailgate's lower
+  /// edge, the front plate in the bumper.
+  constexpr float RearHeight = 52.0f;
+  constexpr float FrontHeight = 45.0f;
+
+  /// The outermost point (along Out, +1 front / -1 rear) where a ray parallel to X through (Y, Z) meets one of the
+  /// triangles (corner triples, indices into Corners); false if it meets none.
+  bool OuterHit(const TArray<FVector> &Corners, const TArray<int32> &Triangles, float Y, float Z, float Out, float &X)
+  {
+    bool bAny = false;
+    float Best = TNumericLimits<float>::Lowest();
+    for (const int32 t : Triangles)
+    {
+      const FVector &A = Corners[t], &B = Corners[t + 1], &C = Corners[t + 2];
+      const float E1y = B.Y - A.Y, E1z = B.Z - A.Z, E2y = C.Y - A.Y, E2z = C.Z - A.Z;
+      const float Det = E1y * E2z - E2y * E1z;
+      if (FMath::Abs(Det) < 1e-6f)
+      {
+        continue;                                             // edge-on to the ray
+      }
+      const float Py = Y - A.Y, Pz = Z - A.Z;
+      const float U = (Py * E2z - E2y * Pz) / Det;
+      const float V = (E1y * Pz - Py * E1z) / Det;
+      if (U < 0.0f || V < 0.0f || U + V > 1.0f)
+      {
+        continue;
+      }
+      const float Along = (A.X + U * (B.X - A.X) + V * (C.X - A.X)) * Out;
+      if (Along > Best)
+      {
+        Best = Along;
+        bAny = true;
+      }
+    }
+    X = Best * Out;
+    return bAny;
+  }
+
+  /// The plates of a vehicle whose meshes carry no plate material (CARLA 1.0's newer vehicles paint the plate into
+  /// the body texture): where its body surface is flat and upright near the usual plate height on the centre line,
+  /// front and back. Rays parallel to the vehicle's axis meet its LOD 0 triangles on a grid the plate's size; the
+  /// height nearest the usual one where the grid finds a flat patch (5 cm deep at most, then 9 cm for curved
+  /// bumpers) wins. Component space of the body mesh (X forward, Z up, cm).
+  TArray<FPlateSpot> BodySpots(const TArray<FVector> &Corners)
+  {
+    TArray<FPlateSpot> Spots;
+    if (Corners.Num() < 3)
+    {
+      return Spots;
+    }
+    FBox Bounds(ForceInit);
+    for (const FVector &P : Corners)
+    {
+      Bounds += P;
+    }
+    const float Ground = Bounds.Min.Z;                         // the wheels' bottom
+    const float Mid = 0.5f * (Bounds.Min.X + Bounds.Max.X);
+    for (const float Out : {1.0f, -1.0f})
+    {
+      const float Extreme = Out > 0.0f ? Bounds.Max.X : Bounds.Min.X;
+      TArray<int32> Triangles;
+      for (int32 t = 0; t + 2 < Corners.Num(); t += 3)
+      {
+        const FVector &A = Corners[t], &B = Corners[t + 1], &C = Corners[t + 2];
+        const float MinY = FMath::Min3(A.Y, B.Y, C.Y), MaxY = FMath::Max3(A.Y, B.Y, C.Y);
+        const float MinZ = FMath::Min3(A.Z, B.Z, C.Z), MaxZ = FMath::Max3(A.Z, B.Z, C.Z);
+        const float Cx = (A.X + B.X + C.X) / 3.0f;
+        if (MaxY < -30.0f || MinY > 30.0f || MaxZ < Ground + 15.0f || MinZ > Ground + 125.0f || (Cx - Mid) * Out < 0.0f)
+        {
+          continue;
+        }
+        Triangles.Add(t);
+      }
+      const float Usual = Ground + (Out > 0.0f ? FrontHeight : RearHeight);
+      bool bFound = false;
+      for (const float Depth : {5.0f, 9.0f})
+      {
+        for (int32 k = 0; k <= 40 && !bFound; ++k)
+        {
+          const float Z = Usual + ((k % 2) ? 1.0f : -1.0f) * 2.0f * ((k + 1) / 2);   // 0, +2, -2, +4, ...
+          if (Z < Ground + 25.0f || Z > Ground + 115.0f)
+          {
+            continue;
+          }
+          float Outer = TNumericLimits<float>::Lowest(), Inner = TNumericLimits<float>::Max();
+          float Low = 0.0f, High = 0.0f;
+          bool bAll = true;
+          for (const float Dy : {-20.0f, -10.0f, 0.0f, 10.0f, 20.0f})
+          {
+            for (const float Dz : {-5.0f, 0.0f, 5.0f})
+            {
+              float X;
+              if (!OuterHit(Corners, Triangles, Dy, Z + Dz, Out, X))
+              {
+                bAll = false;
+                break;
+              }
+              Outer = FMath::Max(Outer, X * Out);
+              Inner = FMath::Min(Inner, X * Out);
+              if (Dy == 0.0f && Dz != 0.0f)
+              {
+                (Dz < 0.0f ? Low : High) = X;
+              }
+            }
+            if (!bAll)
+            {
+              break;
+            }
+          }
+          // flat, and the body's outside there (not the underbody or a deep recess)
+          if (!bAll || Outer - Inner > Depth || Extreme * Out - Outer > 35.0f)
+          {
+            continue;
+          }
+          const float Slope = (High - Low) / 10.0f;                // x per z on the centre line
+          FVector N(Out, 0.0f, -Slope * Out);
+          N.Normalize();
+          N.Z = FMath::Clamp(N.Z, -0.35, 0.35);                    // plates stand roughly upright
+          N.Normalize();
+          FPlateSpot Spot;
+          Spot.Centre = FVector(Outer * Out, 0.0f, Z);
+          Spot.Normal = N;
+          Spot.Size = FVector2D(40.0, 12.0);
+          Spot.bFront = Out > 0.0f;
+          Spots.Add(Spot);
+          bFound = true;
+        }
+      }
+    }
+    return Spots;
+  }
