+  /// Plate spots the client sent with the country ("ES;rear=x,y,z,nx,ny,nz;front=..."; cm, the body mesh's
+  /// component space, as the server logs them for a vehicle it measured): for servers whose meshes have no CPU copy.
+  TArray<FPlateSpot> SentSpots(const TArray<FString> &Parts)
+  {
+    TArray<FPlateSpot> Spots;
+    for (int32 i = 1; i < Parts.Num(); ++i)
+    {
+      FString Key, Value;
+      if (!Parts[i].Split(TEXT("="), &Key, &Value))
+      {
+        continue;
+      }
+      TArray<FString> Numbers;
+      Value.ParseIntoArray(Numbers, TEXT(","));
+      Key = Key.TrimStartAndEnd().ToLower();
+      if (Numbers.Num() != 6 || (Key != TEXT("rear") && Key != TEXT("front")))
+      {
+        continue;
+      }
+      FPlateSpot Spot;
+      Spot.Centre = FVector(FCString::Atof(*Numbers[0]), FCString::Atof(*Numbers[1]), FCString::Atof(*Numbers[2]));
+      Spot.Normal = FVector(FCString::Atof(*Numbers[3]), FCString::Atof(*Numbers[4]), FCString::Atof(*Numbers[5])).GetSafeNormal();
+      Spot.Size = FVector2D(40.0, 12.0);
+      Spot.bFront = Key == TEXT("front");
+      if (!Spot.Normal.IsNearlyZero())
+      {
+        Spots.Add(Spot);
+      }
+    }
+    return Spots;
+  }
+
