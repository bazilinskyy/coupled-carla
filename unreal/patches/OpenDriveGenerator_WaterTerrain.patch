   for (int32 IY = 0; IY < NumY; ++IY)
@@ -1161,10 +1284,25 @@ void AOpenDriveGenerator::GenerateGroundPlane()
           }
         }
       }
+      if (CCWater.Num() > 0 && !(Cell && Cell->bPaved))
+      {
+        const float WaterZ = CCWaterLevel(CCWater, CCParity, X, Y);
+        if (WaterZ != FLT_MAX && GroundZ > WaterZ - CCWaterDip)
+        {
