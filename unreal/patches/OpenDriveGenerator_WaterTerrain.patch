+          ++CCDipped;
+        }
+      }
       Heights[IY * NumX + IX] = GroundZ;
     }
   }
 
+  if (CCWater.Num() > 0)
+  {
+    UE_LOG(LogCarla, Log, TEXT("AOpenDriveGenerator: %d water rings (coupled-carla), terrain lowered under water at %d of %d vertices"),
+        CCWater.Num(), CCDipped, NumX * NumY);
+  }
