 // scatter of generate_opendrive_world. Hybrid rendering over a neural scene
 // needs a bare proxy world: furniture that only exists in the proxy casts
 // shadows on the synthetic actors and shows up in their reflections.
+// coupled-carla: water bodies sent with the OpenDRIVE as
+//   <userData code="coupledcarla.water">
+//   <body> <level m> x,y x,y ...      (one closed ring a line; CARLA metres)
+//   </userData>
+// The generated terrain is fitted to the road heights, so over a river or a
+// harbour it spreads at the banks' height and buries the water (Hoek van
+// Holland: 1.3-5.9 m over a 1.1 m water level). Inside a body (even-odd over
+// its rings, so islands stay land) and away from pavement, the terrain is
+// lowered CCWaterDip below the body's level; without the userData nothing
+// changes. Posted with coupled-carla (unreal/patches/), not upstream.
+namespace
+{
+  struct FCCWaterRing
+  {
+    int32 Body = 0;
+    float LevelZ = 0.0f;
+    TArray<FVector2D> Pts;
+    FBox2D Box = FBox2D(ForceInit);
+  };
+
+  TArray<FCCWaterRing> ParseCCWater(const FString &Xodr)
+  {
+    TArray<FCCWaterRing> Out;
+    const FString Open = TEXT("<userData code=\"coupledcarla.water\">");
+    const int32 A = Xodr.Find(Open, ESearchCase::CaseSensitive);
+    if (A == INDEX_NONE)
+    {
+      return Out;
+    }
+    const int32 Start = A + Open.Len();
+    const int32 B = Xodr.Find(TEXT("</userData>"), ESearchCase::CaseSensitive, ESearchDir::FromStart, Start);
+    if (B == INDEX_NONE)
+    {
+      return Out;
+    }
+    TArray<FString> Lines;
+    Xodr.Mid(Start, B - Start).ParseIntoArrayLines(Lines);
+    for (const FString &Line : Lines)
+    {
+      TArray<FString> Tok;
+      Line.ParseIntoArrayWS(Tok);
+      if (Tok.Num() < 5)
+      {
+        continue;
+      }
+      FCCWaterRing R;
+      R.Body = FCString::Atoi(*Tok[0]);
+      R.LevelZ = FCString::Atof(*Tok[1]) * 100.0f;
+      for (int32 I = 2; I < Tok.Num(); ++I)
+      {
+        FString XS, YS;
+        if (Tok[I].Split(TEXT(","), &XS, &YS))
+        {
+          const FVector2D P(FCString::Atof(*XS) * 100.0f, FCString::Atof(*YS) * 100.0f);
+          R.Pts.Add(P);
+          R.Box += P;
+        }
+      }
+      if (R.Pts.Num() >= 3 && R.Body >= 0)
+      {
+        Out.Add(MoveTemp(R));
+      }
+    }
+    return Out;
+  }
+
+  bool CCInRing(const FCCWaterRing &R, float X, float Y)
+  {
+    if (X < R.Box.Min.X || X > R.Box.Max.X || Y < R.Box.Min.Y || Y > R.Box.Max.Y)
+    {
+      return false;
+    }
+    bool bIn = false;
+    for (int32 I = 0, J = R.Pts.Num() - 1; I < R.Pts.Num(); J = I++)
+    {
+      const FVector2D &Pi = R.Pts[I];
+      const FVector2D &Pj = R.Pts[J];
+      if (((Pi.Y > Y) != (Pj.Y > Y)) && (X < (Pj.X - Pi.X) * (Y - Pi.Y) / (Pj.Y - Pi.Y) + Pi.X))
+      {
+        bIn = !bIn;
+      }
+    }
+    return bIn;
+  }
+
+  // The lowest level of the bodies (X, Y) lies in (cm), or FLT_MAX.
+  float CCWaterLevel(const TArray<FCCWaterRing> &Rings, TArray<uint8> &Parity, float X, float Y)
+  {
+    for (uint8 &P : Parity)
+    {
+      P = 0;
+    }
+    for (const FCCWaterRing &R : Rings)
+    {
+      if (CCInRing(R, X, Y))
+      {
+        Parity[R.Body] ^= 1;
+      }
+    }
+    float Z = FLT_MAX;
+    for (const FCCWaterRing &R : Rings)
+    {
+      if (Parity[R.Body])
+      {
+        Z = FMath::Min(Z, R.LevelZ);
+      }
+    }
+    return Z;
+  }
+}
